{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pump rule file",
  "description": "Schema for Pump rule files with a top-level rules array.",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "description": "Ordered Pump rules. Rules run top-to-bottom.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["name", "match"],
      "properties": {
        "name": {
          "description": "Human-readable rule name used in diagnostics and provenance.",
          "type": "string",
          "minLength": 1
        },
        "match": {
          "description": "Pump path selecting the target value or values for this rule.",
          "type": "string",
          "minLength": 1
        },
        "apiVersion": {
          "description": "Optional Kubernetes-style apiVersion selector.",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "Optional Kubernetes-style kind selector.",
          "type": "string",
          "minLength": 1
        },
        "metadataName": {
          "description": "Optional Kubernetes-style metadata.name selector.",
          "type": "string",
          "minLength": 1
        },
        "metadata.name": {
          "description": "Optional Kubernetes-style metadata.name selector using Pump's dotted rule-field spelling.",
          "type": "string",
          "minLength": 1
        },
        "defaults": {
          "description": "Object merged into each match only where fields are missing.",
          "$ref": "#/$defs/objectValue"
        },
        "overrides": {
          "description": "Object merged into each match, replacing authored values where specified.",
          "$ref": "#/$defs/objectValue"
        },
        "delete": {
          "description": "Relative or absolute paths removed from each match.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replace": {
          "description": "Value that replaces each matched value. Cannot be combined with defaults, overrides, or delete.",
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": ["defaults"]
            },
            {
              "required": ["overrides"]
            },
            {
              "required": ["delete"]
            },
            {
              "required": ["replace"]
            }
          ]
        },
        {
          "if": {
            "required": ["replace"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["defaults"]
                },
                {
                  "required": ["overrides"]
                },
                {
                  "required": ["delete"]
                }
              ]
            }
          }
        }
      ]
    },
    "objectValue": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "jsonValue": {
      "description": "Any JSON-compatible value. YAML mappings, sequences, and scalars are accepted by Pump.",
      "type": ["null", "boolean", "number", "string", "array", "object"],
      "items": {
        "$ref": "#/$defs/jsonValue"
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    }
  }
}
