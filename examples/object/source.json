{
  "api": {
    "image": "ghcr.io/acme/payments-api:v1.8.0",
    "port": 8080,
    "resources": {
      "cpu": "250m"
    }
  },
  "worker": {
    "image": "ghcr.io/acme/payments-worker:v1.8.0",
    "queue": "payments"
  },
  "scheduler": {
    "image": "ghcr.io/acme/payments-scheduler:v1.8.0",
    "schedule": "*/10 * * * *"
  }
}
